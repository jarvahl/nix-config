+function formatTelegramHtml(text: string): string {
+	const renderer = new Renderer();
+	renderer.heading = ({ tokens }) => `<b>${renderer.parser.parseInline(tokens)}</b>\n`;
+	renderer.strong = ({ tokens }) => `<b>${renderer.parser.parseInline(tokens)}</b>`;
+	renderer.em = ({ tokens }) => `<i>${renderer.parser.parseInline(tokens)}</i>`;
+	renderer.del = ({ tokens }) => `<s>${renderer.parser.parseInline(tokens)}</s>`;
+	renderer.codespan = ({ text: code }) => `<code>${code}</code>`;
+	renderer.code = ({ text: code, lang }) => `<pre><code${lang ? ` class="language-${lang}"` : ""}>${code}</code></pre>\n`;
+	renderer.blockquote = ({ tokens }) => `<blockquote>${renderer.parser.parse(tokens)}</blockquote>\n`;
+	renderer.paragraph = ({ tokens }) => `${renderer.parser.parseInline(tokens)}\n`;
+	renderer.br = () => "\n";
+	renderer.list = ({ items }) => items.map((item) => renderer.listitem(item)).join("");
+	renderer.listitem = ({ tokens, task, checked }) => {
+		const marker = task ? (checked ? "☑" : "☐") : "•";
+		return `${marker} ${renderer.parser.parse(tokens).trim()}\n`;
+	};
+	renderer.checkbox = () => "";
+	renderer.table = ({ header, rows }) => {
+		const renderRow = (row: Array<{ tokens: unknown[] }>) => row.map((cell) => renderer.parser.parseInline(cell.tokens).replace(/<[^>]*>/g, "").trim());
+		const renderedRows = [renderRow(header), ...rows.map(renderRow)];
+		const widths = renderedRows[0].map((_, column) => Math.max(...renderedRows.map((row) => (row[column] || "").length)));
+		const formatRow = (row: string[]) => row.map((cell, column) => cell.padEnd(widths[column])).join("  ").trimEnd();
+		const lines = [formatRow(renderedRows[0]), widths.map((width) => "-".repeat(width)).join("  "), ...renderedRows.slice(1).map(formatRow)];
+		return `<pre>${lines.join("\n")}</pre>\n`;
+	};
+	renderer.image = ({ text: alt }) => alt;
+	renderer.hr = () => "—\n";
+	renderer.html = ({ text: html }) => html.replace(/<[^>]*>/g, "");
+	renderer.link = ({ href, title, tokens }) => `<a href="${href}"${title ? ` title="${title}"` : ""}>${renderer.parser.parseInline(tokens)}</a>`;
+	return marked.parse(remend(text), { async: false, renderer }).trim();
+}
