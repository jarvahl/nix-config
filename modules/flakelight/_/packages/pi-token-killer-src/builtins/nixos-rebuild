#!/bin/sh
set -eu

self_dir=$(CDPATH= cd -P -- "${0%/*}" && pwd)
PATH=$(printf '%s' "$PATH" | awk -v RS=: -v self="$self_dir" \
  '$0 != self { if (n++) printf ":"; printf "%s", $0 }')
export PATH
real_nixos_rebuild=$(command -v nixos-rebuild) || {
  printf '%s\n' 'pi-token-killer: nixos-rebuild not found after removing the current wrapper' >&2
  exit 127
}

action=${1-}
case "$action" in
  ""|help|--help|-h|version|--version) exec "$real_nixos_rebuild" "$@" ;;
esac

output=$(mktemp)
trap 'rm -f "$output"' EXIT

set +e
"$real_nixos_rebuild" "$@" >"$output" 2>&1
status=$?
set -e

if [ "$status" -ne 0 ]; then
  cat "$output"
else
  system=$(grep -o '/nix/store/[^[:space:]]*-nixos-system-[^[:space:]]*' "$output" | tail -1 || true)
  if [ -n "$system" ]; then
    printf 'ok %s\n' "$system"
  else
    cat "$output"
  fi
fi
exit "$status"
