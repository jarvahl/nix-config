#!/bin/sh

case "${1:-}" in
  refresh)
    pane=${2:?pane id required}
    window=$(tmux display-message -p -t "$pane" '#{window_id}')

    if [ "$(tmux display-message -p -t "$pane" '#{@pi_agent}')" = 1 ]; then
      tmux set-option -p -t "$pane" @pi_status idle
    fi

    status=$(tmux list-panes -t "$window" -F '#{@pi_agent}:#{@pi_status}' | awk -F: '
      $1 == "1" { found = 1; if ($2 == "working") working = 1; if ($2 == "unread") unread = 1 }
      END { if (working) print "working"; else if (unread) print "unread"; else if (found) print "idle"; else print "" }
    ')

    tmux set-option -w -t "$window" @pi_window_status "$status"
    tmux refresh-client -S
    ;;
esac
