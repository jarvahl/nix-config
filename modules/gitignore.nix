{ config, lib, ... }:
let
  cfg = config.git.ignore;
  header = "# Generated by local gitignore module. DO NOT EDIT.";
  content =
    lib.concatStringsSep "\n" (
      [
        header
        ""
      ]
      ++ cfg
    )
    + "\n";
in
{
  options.git.ignore = lib.mkOption {
    default = [ ];
    description = "Git ignore patterns in module merge order; one pattern per string.";
    type = lib.types.listOf (
      lib.types.addCheck lib.types.str (
        pattern: !(lib.hasInfix "\n" pattern || lib.hasInfix "\r" pattern)
      )
    );
  };

  config.perSystem =
    { pkgs, ... }:
    let
      source = pkgs.writeText "gitignore" content;
      sync = pkgs.writeShellApplication {
        name = "gitignore";
        runtimeInputs = [
          pkgs.coreutils
          pkgs.gitMinimal
        ];
        text = ''
          if [ "$#" -ne 0 ]; then
            echo 'Usage: gitignore (from inside the target Git repository)' >&2
            exit 1
          fi
          root=$(git rev-parse --show-toplevel)
          cd "$root"
          if [ -L .gitignore ] || { [ -e .gitignore ] && [ ! -f .gitignore ]; }; then
            echo 'Refusing to replace a symlink or non-regular .gitignore' >&2
            exit 1
          fi
          if [ -f .gitignore ]; then
            IFS= read -r first_line < .gitignore || true
            if [ "$first_line" != ${lib.escapeShellArg header} ]; then
              echo 'Refusing to overwrite unmanaged .gitignore; migrate its patterns into Nix and move it aside first.' >&2
              exit 1
            fi
            if cmp -s ${source} .gitignore; then
              exit 0
            fi
          fi
          temporary=$(mktemp .gitignore.XXXXXX)
          trap 'rm -f -- "$temporary"' EXIT
          cp ${source} "$temporary"
          chmod 644 "$temporary"
          mv -f -- "$temporary" .gitignore
        '';
      };
    in
    {
      apps.gitignore = {
        meta.description = "Synchronize the current Git repository's managed .gitignore";
        program = lib.getExe sync;
        type = "app";
      };

      packages = {
        gitignore = sync;
        gitignore-file = source;
      };

      files.file.".gitignore".source = source;
    };

}
