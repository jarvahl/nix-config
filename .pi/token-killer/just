#!/bin/sh
set -eu

self_dir=$(CDPATH= cd -P -- "${0%/*}" && pwd)
PATH=$(printf '%s' "$PATH" | awk -v RS=: -v self="$self_dir" \
  '$0 != self { if (n++) printf ":"; printf "%s", $0 }')
export PATH

real_just=$(command -v just) || {
  printf '%s\n' 'pi-token-killer: just not found after removing the current wrapper' >&2
  exit 127
}

case ${1-} in
  build|switch|boot) ;;
  *) exec "$real_just" "$@" ;;
esac

output=$(mktemp)
trap 'rm -f "$output"' EXIT

set +e
"$real_just" "$@" >"$output" 2>&1
status=$?
set -e

if [ "$status" -ne 0 ]; then
  cat "$output"
  exit "$status"
fi

system=$(grep -o '/nix/store/[^[:space:]]*-nixos-system-[^[:space:]]*' "$output" | tail -1 || true)
if [ -n "$system" ]; then
  printf 'ok %s\n' "$system"
else
  cat "$output"
fi
